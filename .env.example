# Vorfahrt Environment Variables

# Traefik configuration
ACME_FILE=/data/acme.json

# Storage directory for database and keys
DATA_DIR=/data

# DKIM configuration
DKIM_KEY_FILE=/data/dkim.key
DKIM_SELECTOR=mail

# Web UI configuration
WEB_ADDR=:8080
WEB_USERNAME=admin
# Set a strong password here to protect the Web UI
WEB_PASSWORD=secret

# SMTP configuration
SMTP_ADDR=:25
SMTP_DOMAIN=mail.example.com
# Set to true if you are exposing port 465 for Implicit TLS
# SMTP_IMPLICIT_TLS=false
