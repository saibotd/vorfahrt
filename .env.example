# ==========================================
# Vorfahrt Environment Variables
# ==========================================

# Path to Traefik's acme.json file
# Used for TLS certificates (STARTTLS) and sender domain validation
ACME_FILE=/data/acme.json

# Storage directory for SQLite database (data.db) and keys
DATA_DIR=/data

# DKIM Configuration
# Private RSA key used for signing outbound emails (auto-generated if missing)
DKIM_KEY_FILE=/data/dkim.key
# DNS selector used in DKIM records (<selector>._domainkey.<domain>)
DKIM_SELECTOR=mail

# Server Identity & SMTP EHLO Domain
# Canonical hostname announced in SMTP EHLO/HELO (e.g. mail.example.com)
# Must match your VPS provider's Reverse DNS (PTR) record for valid FCrDNS
SMTP_DOMAIN=mail.example.com

# SMTP Server Configuration
# Listening address and port for incoming SMTP traffic
SMTP_ADDR=:25
# Set to true if exposing port 465 for Implicit TLS (SMTPS). Defaults to false (STARTTLS on port 25/587).
# SMTP_IMPLICIT_TLS=false

# Web UI & API Configuration
WEB_ADDR=:8080
WEB_USERNAME=admin
# Strong password to protect the Web UI (if left empty, authentication is disabled)
WEB_PASSWORD=secret
